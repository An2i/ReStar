  "f48b79a3a88646a1b2c8e8e491280c9f": {
    "id": "f48b79a3a88646a1b2c8e8e491280c9f",
    "name": "cdb",
    "command_line": "\"D:\\Rolan\\bin\\ReverseTools\\WinDbg(x64)\\cdb.exe\" -logo \"{log_path}\" -c \"{commands}; q\" \"{target_path}\"",
    "sandbox_command_line": "\"D:\\Tools\\WinDbg(x64)\\cdb.exe\" -logo \"{log_path}\" -c \"{commands}; q\" \"{target_path}\"",
    "description": "使用 Windows Debugging Tools 的 cdb 调试 Windows 可执行程序。适用于加载 EXE、设置断点、运行、查看寄存器/调用栈/模块/异常信息。参数 target_path 为待调试程序路径，commands 为 cdb 命令序列，log_path 为日志输出路径。示例完整命令：\"D:\\Rolan\\bin\\ReverseTools\\WinDbg(x64)\\cdb.exe\" -logo \"C:\\log.txt\" -c \".symfix; g; q\" \"D:\\test.exe\"。",
    "input_schema": {
      "type": "object",
      "required": [
        "commands",
        "target_path"
      ],
      "properties": {
        "log_path": {
          "type": "string",
          "description": "设置调试会话的日志输出文件路径"
        },
        "commands": {
          "type": "string",
          "description": "执行指定的调试命令字符串，并在命令结束后自动退出"
        },
        "target_path": {
          "type": "string",
          "description": "要调试的目标程序或文件路径"
        }
      }
    },
    "is_builtin": false,
    "created_at": "2026-05-29T06:21:08.306480+00:00",
    "updated_at": "2026-06-01T09:59:36.740588+00:00"
  },
  "a26a125983b84b159aecc493188b17b0": {
    "id": "a26a125983b84b159aecc493188b17b0",
    "name": "GDB",
    "command_line": "gdb -q -batch -ex \"{commands}\" \"{target_path}\"",
    "sandbox_command_line": "gdb -q -batch -ex \"{commands}\" \"{target_path}\"",
    "description": "使用 GNU gdb 调试或分析可执行程序。参数 target_path 为目标程序路径，commands 为 gdb 命令序列。适合查看入口点、反汇编、断点、寄存器、调用栈、符号、内存映射等信息。示例 commands: \"info files; info functions; disassemble main; quit\"。",
